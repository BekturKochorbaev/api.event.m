{
  "slide": {
    "type": "grid_card_showcase_slide",
    "aspect_ratio": "16:9",
    "layout": {
      "description": "logo_top_left_title_below_intro_paragraph_then_2x3_grid_of_icon_cards_each_with_image",
      "columns": 3,
      "rows": 2
    },
    "style": {
      "background": "warm_off_white",
      "overall_style": "elegant_corporate_editorial",
      "alignment": "left"
    },
    "elements": [
      {
        "id": "el_1",
        "type": "logo",
        "role": "brand_logo_top_left",
        "position": { "x": 2, "y": 2, "width": 16, "height": 7 },
        "content": "company logo mark with wordmark and small tagline beneath",
        "typography": { "size": "small", "weight": "regular", "alignment": "left" },
        "style": { "color": "mixed_dark_and_accent" }
      },
      {
        "id": "el_2",
        "type": "title",
        "role": "main_slide_title",
        "position": { "x": 2, "y": 10, "width": 96, "height": 10 },
        "content": "large bold main section title, letter-spaced",
        "typography": { "size": "xlarge", "weight": "bold", "alignment": "left", "style": "serif" },
        "style": { "color": "dark" }
      },
      {
        "id": "el_3",
        "type": "divider",
        "role": "title_underline_with_center_mark",
        "position": { "x": 2, "y": 20, "width": 96, "height": 2 },
        "content": "full-width thin horizontal rule with small centered symbol",
        "style": { "color": "accent", "thickness": "hairline" }
      },
      {
        "id": "el_4",
        "type": "text_block",
        "role": "intro_descriptive_paragraph",
        "position": { "x": 2, "y": 23, "width": 55, "height": 6 },
        "content": "short two-line introductory paragraph explaining the slide's purpose",
        "typography": { "size": "medium", "weight": "regular", "alignment": "left" },
        "style": { "color": "dark" }
      },
      {
        "id": "el_5",
        "type": "card",
        "role": "channel_card_1",
        "position": { "x": 2, "y": 30, "width": 31, "height": 30 },
        "content": "card with icon badge, numbered title, short description, and supporting image mockup below",
        "typography": { "size": "small", "weight": "regular", "alignment": "left" },
        "style": { "color": "dark", "background": "white", "border_radius": "medium", "border": "thin_light" }
      },
      {
        "id": "el_6",
        "type": "card",
        "role": "channel_card_2",
        "position": { "x": 35, "y": 30, "width": 31, "height": 30 },
        "content": "card with icon badge, numbered title, short description, and supporting image mockup below (browser/website style)",
        "typography": { "size": "small", "weight": "regular", "alignment": "left" },
        "style": { "color": "dark", "background": "white", "border_radius": "medium", "border": "thin_light" }
      },
      {
        "id": "el_7",
        "type": "card",
        "role": "channel_card_3",
        "position": { "x": 68, "y": 30, "width": 31, "height": 30 },
        "content": "card with icon badge, numbered title, short description, and supporting image mockup below (outdoor screen style)",
        "typography": { "size": "small", "weight": "regular", "alignment": "left" },
        "style": { "color": "dark", "background": "white", "border_radius": "medium", "border": "thin_light" }
      },
      {
        "id": "el_8",
        "type": "card",
        "role": "channel_card_4",
        "position": { "x": 2, "y": 62, "width": 31, "height": 30 },
        "content": "card with icon badge, numbered title, short description, and supporting image mockup below (phone-in-hand style)",
        "typography": { "size": "small", "weight": "regular", "alignment": "left" },
        "style": { "color": "dark", "background": "white", "border_radius": "medium", "border": "thin_light" }
      },
      {
        "id": "el_9",
        "type": "card",
        "role": "channel_card_5",
        "position": { "x": 35, "y": 62, "width": 31, "height": 30 },
        "content": "card with icon badge, numbered title, short description, and supporting image mockup below (invitation card style)",
        "typography": { "size": "small", "weight": "regular", "alignment": "left" },
        "style": { "color": "dark", "background": "white", "border_radius": "medium", "border": "thin_light" }
      },
      {
        "id": "el_10",
        "type": "card",
        "role": "channel_card_6",
        "position": { "x": 68, "y": 62, "width": 31, "height": 30 },
        "content": "card with icon badge, numbered title, short description, and supporting image mockup below (multi-phone social media UI style)",
        "typography": { "size": "small", "weight": "regular", "alignment": "left" },
        "style": { "color": "dark", "background": "white", "border_radius": "medium", "border": "thin_light" }
      },
      {
        "id": "el_11",
        "type": "divider",
