# Copy to .env and fill in. Without OPENAI_API_KEY the project runs in
# DEMO_MODE automatically and renders wireframe placeholders instead.

SECRET_KEY=django-insecure-change-me
DEBUG=true
ALLOWED_HOSTS=*

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=2

# zones    — короткий зонный бриф (по умолчанию), модель хорошо компонует
# detailed — полная спецификация с координатами, точнее по шаблону на бумаге,
#            но модель её плохо соблюдает и режет текст по краям
IMAGE_PROMPT_STYLE=zones

# Force placeholders even when a key is present (saves money while building).
# DEMO_MODE=true
